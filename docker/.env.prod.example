# Copy to docker/.env.prod on the VPS and fill in EVERY value.
# Required keys are enforced by `${VAR:?...}` in docker-compose.prod.yml,
# so a missing entry will fail-fast at `docker compose up`.

# Public hostname pointing to the VPS (A/AAAA record must exist).
SITE_DOMAIN=example.com

# Email used by Let's Encrypt for renewal notices.
ACME_EMAIL=ops@example.com

# Database — pick strong, unique passwords.
DB_NAME=golden_hive
DB_USER=golden_hive
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-stronger-root-password
WP_TABLE_PREFIX=wp_

# Backups — host-side path that will hold .sql.gz dumps.
BACKUP_DIR=/var/backups/golden-hive
BACKUP_KEEP_DAYS=14
