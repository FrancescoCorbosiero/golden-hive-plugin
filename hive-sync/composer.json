{
    "name": "hive-sync/plugin",
    "description": "Hive Sync — Woo product import/export with reusable mappings, rules, and scheduled jobs.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "HiveSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HiveSync\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "vendor-dir": "vendor"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
