golden-hive/vendor/bin
golden-hive/vendor/myclabs
golden-hive/vendor/nikic
golden-hive/vendor/phar-io
golden-hive/vendor/phpunit
golden-hive/vendor/sebastian
golden-hive/vendor/theseer
