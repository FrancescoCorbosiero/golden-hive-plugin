# Copy to docker/.env.dev and tweak as needed.
# All values here have sane defaults baked into the compose file — they
# are duplicated here for visibility.

WP_HTTP_PORT=8080
ADMINER_PORT=8081
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
WP_TABLE_PREFIX=wp_

# WP admin bootstrap — used by docker/scripts/wp-init.sh.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.test
WP_TITLE="Hive Commerce Dev"
