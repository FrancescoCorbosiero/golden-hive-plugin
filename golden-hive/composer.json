{
    "name": "golden-hive/plugin",
    "description": "Golden Hive — WooCommerce suite (catalogo, tassonomia, media, import/export, feed esterni).",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "GH\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GH\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "vendor-dir": "vendor"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
